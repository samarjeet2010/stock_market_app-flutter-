# Copy this file to .env and fill in real values before running the server.

# Port the API server listens on
PORT=3000

# Secret used to sign JWT auth tokens - change this to a long random string
JWT_SECRET=change_this_to_a_long_random_secret

# How long login tokens stay valid
JWT_EXPIRES_IN=30d

# Starting virtual cash balance given to every new signup
STARTING_BALANCE=100000

# How often (ms) simulated stock prices tick, e.g. 4000 = every 4 seconds
PRICE_TICK_INTERVAL_MS=4000

# Google Gemini API key used by the AI Advisor endpoint (server-side only,
# never shipped in the app). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Razorpay keys used by the "Add Money" wallet feature (server-side only).
# Get TEST keys at https://dashboard.razorpay.com/app/keys (no business
# verification needed for test mode). If left blank, Add Money runs in a
# built-in mock mode so it still works end-to-end for local testing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
